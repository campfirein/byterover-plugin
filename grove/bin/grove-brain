#!/bin/sh
# Generated by @byterover/grove-plugin. Finds the installed Grove app and runs its
# bundled Company Brain MCP server. Edit apps/plugin in the grove repository instead.
set -eu

for app in 	"${GROVE_APP:-}" 	"/Applications/Grove.app" 	"$HOME/Applications/Grove.app" 	"/Applications/Grove Dev.app" 	"$HOME/Applications/Grove Dev.app" 	"/opt/Grove" 	"$HOME/.local/share/Grove"
do
	[ -n "$app" ] || continue
	[ -d "$app" ] || continue

	# A REPOSITORY CHECKOUT, which is what an engineer runs day to day: `pnpm dev` builds the same
	# server into out/main and runs it with the Electron in node_modules. Nothing here is packaged,
	# so this is checked before the app layouts rather than derived from them.
	if [ -f "$app/apps/desktop/out/main/grove-brain-mcp.js" ]; then
		electron="$app/apps/desktop/node_modules/electron"
		[ -f "$electron/path.txt" ] || continue
		binary="$electron/dist/$(cat "$electron/path.txt")"
		[ -x "$binary" ] || continue
		GROVE_BRAIN_HOST=codex ELECTRON_RUN_AS_NODE=1 exec "$binary" "$app/apps/desktop/out/main/grove-brain-mcp.js" "$@"
	fi

	# macOS keeps the binary under Contents/MacOS, named after the bundle: "Grove Dev.app" holds
	# "Grove Dev". A Linux install is a plain directory with the binary at its root.
	name=$(basename "$app" .app)
	if [ -x "$app/Contents/MacOS/$name" ]; then
		binary="$app/Contents/MacOS/$name"
		resources="$app/Contents/Resources"
	elif [ -x "$app/$name" ]; then
		binary="$app/$name"
		resources="$app/resources"
	else
		continue
	fi

	# A packaged build keeps its code in app.asar; an unpacked one in app/. Nothing inside an asar
	# can be tested for, so the archive itself is what decides.
	if [ -f "$resources/app.asar" ]; then
		server="$resources/app.asar/out/main/grove-brain-mcp.js"
	elif [ -d "$resources/app" ]; then
		server="$resources/app/out/main/grove-brain-mcp.js"
	else
		continue
	fi

	GROVE_BRAIN_HOST=codex ELECTRON_RUN_AS_NODE=1 exec "$binary" "$server" "$@"
done

echo "grove-brain: Grove Desktop was not found. Install it, or set GROVE_APP to its location." >&2
exit 1
